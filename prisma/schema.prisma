model Presensi{
  id  String @id @default(uuid())
  employee_name String 
  attendance_date DateTime @default(now())
  check_in DateTime 
  check_out DateTime 
  status StatusPresensi
  notes String?
  created_at  DateTime
  updated_at  DateTime
}

enum StatusPresensi {
 PRESENT 
 SiCK 
 LEAVE 
 ABSENT
}
