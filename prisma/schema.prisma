// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../assets/ERD.svg"
  theme    = "neutral"
}

datasource db {
  provider = "postgresql"
}

model Karyawan {
  id         String     @id @default(uuid())
  name       String     @db.VarChar(255)
  email      String     @unique @db.VarChar(255)
  password   String     @db.VarChar(255)
  role       Role       @default(WORKER)
  presensi   Presensi[]
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
}

model Presensi {
  id              String         @id @default(uuid())
  karyawan        Karyawan       @relation(fields: [karyawan_id], references: [id])
  karyawan_id     String
  attendance_date DateTime       @default(now()) @db.Date
  check_in        DateTime?       @db.Time
  check_out       DateTime?      @db.Time
  status          StatusPresensi
  notes           String?        @db.VarChar(500)
  deleted_at      DateTime?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  @@unique([karyawan_id, attendance_date])
  @@index([deleted_at])
  @@index([status])
  @@index([attendance_date])
}

enum Role {
  ADMIN
  WORKER
}

enum StatusPresensi {
  PRESENT
  SICK
  LEAVE
  ABSENT
}
